<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | where_exp: "p", "p.layout" | where_exp: "p", "p.sitemap != false" | sort: "url" %}
{%- for p in pages %}
