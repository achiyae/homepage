@Article{Sipper2014LunchIsn,
  author    = {Sipper, Moshe and Elyasaf, Achiya},
  journal   = {ACM SIGEVOlution},
  title     = {{Lunch Isn't Free --- but Cells Are}},
  year      = {2014},
  issn      = {1931-8499},
